{
  "schema_version": 1,
  "project": "Physical AI",
  "book": {
    "quarto_config": "book/_quarto.yml",
    "book_goal": "docs/BOOK-GOAL.md",
    "chapter_outline": "docs/CHAPTER-OUTLINES.md",
    "authoring_system": "docs/AUTHORING-SYSTEM.md",
    "voice_rules": ".claude/rules/voice-and-prose.md",
    "chapter_packets": {
      "CH01": [
        "docs/packets/CH01-AUTHORING-PACKET.md",
        "docs/packets/CH01-SOURCE-PACKET.md",
        "docs/packets/CH01-REPRESENTATION-PACKET.md"
      ],
      "CH02": [
        "docs/packets/CH02-AUTHORING-PACKET.md"
      ]
    }
  },
  "execution": {
    "serialize_chapters": true,
    "serialize_sections": true,
    "max_parallel_agents": 3,
    "max_section_revision_rounds": 2,
    "max_chapter_revision_rounds": 2,
    "max_book_revision_rounds": 2,
    "human_approval": [
      "chapter_architecture",
      "chapter_acceptance",
      "book_acceptance"
    ]
  },
  "roles": {
    "chapter_research": [
      "domain_scout",
      "pedagogy_auditor",
      "representation_planner"
    ],
    "chapter_review": [
      "technical_reviewer",
      "progression_reviewer",
      "practitioner_reviewer"
    ],
    "section_support": [
      "domain_scout",
      "pedagogy_auditor",
      "representation_planner"
    ],
    "section_review": [
      "technical_reviewer",
      "progression_reviewer",
      "continuity_reviewer",
      "practitioner_reviewer",
      "representation_reviewer"
    ],
    "chapter_feedback": [
      "technical_reviewer",
      "progression_reviewer",
      "continuity_reviewer",
      "representation_reviewer",
      "practitioner_reviewer"
    ],
    "book_feedback": [
      "novice_book_reviewer",
      "transfer_book_reviewer",
      "citation_book_reviewer",
      "systems_book_reviewer",
      "lab_book_reviewer",
      "visual_book_reviewer",
      "voice_book_reviewer"
    ]
  }
}
