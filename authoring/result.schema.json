{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai.local/schemas/authoring-result.schema.json",
  "title": "Physical AI authoring task result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "outcome",
    "summary",
    "manuscript",
    "artifacts",
    "sources",
    "context_changes",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "outcome": {
      "enum": ["pass", "revise", "complete", "not_needed", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "manuscript": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["section_id", "markdown"],
          "properties": {
            "section_id": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "type", "purpose", "reader_inference", "status"],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "type": {
            "enum": ["figure", "table", "equation", "algorithm", "trace", "worked_example", "other"]
          },
          "purpose": {
            "type": "string"
          },
          "reader_inference": {
            "type": "string"
          },
          "status": {
            "enum": ["proposed", "drafted", "reviewed", "not_needed"]
          },
          "content": {
            "type": ["string", "null"]
          },
          "alt_text": {
            "type": ["string", "null"]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "claim_supported"],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "claim_supported": {
            "type": "string"
          },
          "notes": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "context_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_terms", "accepted_claims", "system_changes", "open_questions", "next_section_may_assume"],
      "properties": {
        "new_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_section_may_assume": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["importance", "owner_section_id", "problem", "smallest_repair", "acceptance_test"],
        "properties": {
          "importance": {
            "enum": ["blocking", "important", "note"]
          },
          "owner_section_id": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "smallest_repair": {
            "type": "string"
          },
          "acceptance_test": {
            "type": "string"
          }
        }
      }
    }
  }
}
