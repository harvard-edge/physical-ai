[Unit]
Description=Maya's Reachy MiOS application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reachy
WorkingDirectory=/opt/mayos-reachy/current
ExecStart=/opt/mayos-reachy/venv/bin/mayas-reachy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mayas-reachy /var/log/mayas-reachy

[Install]
WantedBy=multi-user.target
