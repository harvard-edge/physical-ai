{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mios.local/schema/substrate-bakeoff-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "scenario_version", "generated_at", "results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "source_tree_digest", "base_commit"],
      "properties": {
        "manifest_path": {"const": "evaluation/manifests/phase1a-source.json"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_tree_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "scenario_version": {"const": "phase1a-durable-cycle-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "results": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["substrate", "substrate_version", "runner_version", "tool_versions", "status", "criterion", "timings_ms", "effects", "duplicates", "terminal_state", "semantic_digest", "raw", "limitations"],
        "properties": {
          "substrate": {"enum": ["dbos", "custom_durable_control", "temporal"]},
          "substrate_version": {"type": ["string", "null"]},
          "runner_version": {"const": "1.0.0"},
          "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
          "status": {"enum": ["passed", "failed", "not_runnable"]},
          "criterion": {"type": "string"},
          "timings_ms": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "effects": {"type": "array", "items": {"type": "string"}},
          "duplicates": {"type": "integer", "minimum": 0},
          "terminal_state": {"type": ["string", "null"]},
          "semantic_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "raw": {"type": "object"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
