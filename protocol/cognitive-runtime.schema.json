{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mios.local/schema/cognitive-runtime-1.0.0.json",
  "title": "MiOS cognitive runtime records",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "record_id", "provenance"],
  "properties": {
    "kind": {"enum": ["goal", "observation", "belief", "skill", "capability", "action_proposal", "checkpoint"]},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "created_at", "privacy_class"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "privacy_class": {"enum": ["synthetic", "derived-redacted", "internal", "restricted"]},
        "evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
