{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physicalai.local/mios/task-packet.schema.json",
  "title": "MiOS Agent Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "experiment_id", "role", "objective", "acceptance_tests", "budgets", "required_outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {"type": "string", "pattern": "^MIOS-EXP-[0-9]{4,}$"},
    "role": {"type": "string", "minLength": 1, "maxLength": 64},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
    "context_files": {"type": "array", "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_minutes", "tokens", "money_usd"],
      "properties": {
        "wall_clock_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "tokens": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "money_usd": {"type": "number", "minimum": 0, "maximum": 10000}
      }
    },
    "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "escalation_conditions": {"type": "array", "items": {"type": "string"}}
  }
}
